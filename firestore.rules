rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isRemoved', false) == false);
    }

    function isAdmin() {
      return signedIn()
        && (
          (('admin' in request.auth.token) && request.auth.token.admin == true)
          || request.auth.token.email in [
            'ayianrana20133@gmail.com',
            'ranasalar964@gmail.com'
          ]
        );
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create, update: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /pro_license_keys/{licenseKey} {
      allow get: if isAdmin() || signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.isUsed == false
          && request.resource.data.isUsed == true);
    }

    match /admin_messages/{messageId} {
      allow read: if isAdmin() || signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /user_reports/{reportId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
